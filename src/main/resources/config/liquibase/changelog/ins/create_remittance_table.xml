    <changeSet id="20250801-01-create-seq-ins-performa-good-item" author="soheil babadi">
        <preConditions onFail="MARK_RAN">
            <not>
                <sequenceExists sequenceName="SEQ_INS_PERFORMA_GOOD_ITEM"/>
            </not>
        </preConditions>


        <createSequence
                sequenceName="SEQ_INS_PERFORMA_GOOD_ITEM"
                startValue="1"
                incrementBy="1"/>
    </changeSet>


