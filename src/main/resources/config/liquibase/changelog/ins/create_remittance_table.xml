        <addForeignKeyConstraint
                baseTableName="T_INS_REMITTANCE_GOOD_ITEM"
                baseColumnNames="F_REMITTANCE_ID"
                constraintName="FK_T_INS_REMITTANCE_GOOD_ITEM_ON_F_REMIITANCE"
                referencedTableName="T_INS_PERFORMA_DETAIL"
