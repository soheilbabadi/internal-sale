UPDATE T_INS_LC lc
SET (N_CUSTOMER_ID, C_CUSTOMER_NAME, N_TOTAL_QUANTITY, N_TOTAL_FINAL_AMOUNT) = (
    SELECT pm.N_CUSTOMER_ID, pm.C_CUSTOMER_NAME, pm.N_TOTAL_QUANTITY, pm.N_TOTAL_FINAL_AMOUNT
    FROM T_INS_PERFORMA_MASTER pm
    WHERE pm.ID = lc.N_PROFORMA_MASTER_ID
)
WHERE EXISTS (
    SELECT 1
    FROM T_INS_PERFORMA_MASTER pm
    WHERE pm.ID = lc.N_PROFORMA_MASTER_ID
);