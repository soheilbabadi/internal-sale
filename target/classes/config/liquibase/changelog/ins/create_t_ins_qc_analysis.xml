            <!-- Current Stage Assays -->
            <column name="N_MOISTURE_PCT" type="NUMBER(10,4)"/>
            <column name="N_AG_PCT" type="NUMBER(10,4)"/>
            <column name="N_AG_KG" type="NUMBER(19,3)"/>
