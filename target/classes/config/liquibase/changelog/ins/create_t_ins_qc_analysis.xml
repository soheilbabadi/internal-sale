            <column name="N_AVG_AG_KG" type="NUMBER(19,3)"/>
            <column name="N_AVG_AG_PPM" type="NUMBER(10,4)"/>
            <column name="N_AVG_AU_PCT" type="NUMBER(10,4)"/>
            <column name="N_AVG_AU_KG" type="NUMBER(19,3)"/>
            <column name="N_AVG_AU_PPM" type="NUMBER(10,4)"/>
            <column name="N_AVG_SE_PCT" type="NUMBER(10,4)"/>
