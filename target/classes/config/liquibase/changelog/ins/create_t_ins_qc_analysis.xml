                                 baseColumnNames="F_ANALYSIS_MASTER_ID"
                                 constraintName="FK_INS_QC_ITEM_TO_MASTER"
                                 referencedTableName="T_INS_QC_ANALYSIS_MASTER"
                                 referencedColumnNames="ID"/>
