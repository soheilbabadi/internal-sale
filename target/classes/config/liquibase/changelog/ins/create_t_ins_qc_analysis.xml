            <column name="N_SE_KG" type="NUMBER(19,3)"/>
            <column name="N_CU_PCT" type="NUMBER(10,4)"/>
            <column name="N_CU_KG" type="NUMBER(19,3)"/>
            <column name="N_PT_PPM" type="NUMBER(10,4)"/>
            <column name="N_PD_PPM" type="NUMBER(10,4)"/>
