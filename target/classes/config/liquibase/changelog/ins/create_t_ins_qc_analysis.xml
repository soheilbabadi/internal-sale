    <!-- ======================================================== -->
    <!-- 1. SEQUENCES                                             -->
    <!-- ======================================================== -->

    <changeSet id="20261020-01-create-seq-qc-analysis-master" author="developer">
        <preConditions onFail="MARK_RAN">
            <not>
                <sequenceExists sequenceName="SEQ_QC_ANALYSIS_MASTER"/>
            </not>
        </preConditions>
        <createSequence sequenceName="SEQ_QC_ANALYSIS_MASTER" startValue="1" incrementBy="1"/>
    </changeSet>

    <changeSet id="20261020-02-create-seq-qc-analysis-item" author="developer">
        <preConditions onFail="MARK_RAN">
            <not>
                <sequenceExists sequenceName="SEQ_QC_ANALYSIS_ITEM"/>
            </not>
        </preConditions>
        <createSequence sequenceName="SEQ_QC_ANALYSIS_ITEM" startValue="1" incrementBy="1"/>
    </changeSet>

    <!-- ======================================================== -->
    <!-- 2. TABLE: T_INS_QC_ANALYSIS_MASTER                       -->
    <!-- ======================================================== -->

    <changeSet id="20261020-03-create-table-qc-analysis-master" author="developer">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="T_INS_QC_ANALYSIS_MASTER"/>
            </not>
        </preConditions>
        <createTable tableName="T_INS_QC_ANALYSIS_MASTER">
            <column name="ID" type="NUMBER(38,0)">
                <constraints primaryKey="true" primaryKeyName="PK_T_INS_QC_ANALYSIS_MASTER" nullable="false"/>
            </column>
            <column name="C_ANALYSIS_STAGE" type="VARCHAR2(30)">
                <constraints nullable="false"/>
            </column>
            <column name="N_COMMODITY_ID" type="NUMBER(38,0)">
                <constraints nullable="false"/>
            </column>
            <column name="C_COMMODITY_CODE" type="VARCHAR2(50)"/>
            <column name="C_COMMODITY_NAME" type="VARCHAR2(200)"/>
            <column name="C_QC_INDICATOR_NO" type="VARCHAR2(100)">
                <constraints nullable="false"/>
            </column>
            <column name="F_PARENT_ANALYSIS_ID" type="NUMBER(38,0)"/>
            <column name="C_REF_INDICATOR_NO" type="VARCHAR2(100)"/>
            <column name="D_REGISTER_DATE" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="C_PERSIAN_REGISTER_DATE" type="VARCHAR2(20)">
                <constraints nullable="false"/>
            </column>
            <column name="D_OFFER_DATE" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="C_PERSIAN_OFFER_DATE" type="VARCHAR2(20)">
                <constraints nullable="false"/>
            </column>
            <column name="F_LOADING_PLACE_ID" type="NUMBER(38,0)"/>
            <column name="C_LOADING_PLACE" type="VARCHAR2(200)"/>
            <column name="C_STATUS" type="VARCHAR2(30)" defaultValue="CONFIRMED">
                <constraints nullable="false"/>
            </column>

            <!-- BaseClassModel Fields -->
            <column name="D_CREATED_DATE" type="DATETIME"/>
            <column name="D_LAST_MODIFIED_DATE" type="DATETIME"/>
            <column name="C_CREATED_BY" type="VARCHAR2(250)"/>
            <column name="C_LAST_MODIFIED_BY" type="VARCHAR2(250)"/>
            <column name="C_COMMENT" type="VARCHAR2(4000)"/>
            <column name="C_DESCRIPTION" type="VARCHAR2(4000)"/>
            <column name="N_VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- ======================================================== -->
    <!-- 3. TABLE: T_INS_QC_ANALYSIS_ITEM                         -->
